# Copy this file to ".env" and set the values for your environment.
# Note: VITE_* variables are bundled into the public JavaScript, so never put secrets here.
VITE_API_URL=https://localhost:7289
# Stripe PUBLISHABLE key only (pk_test_... / pk_live_...). Never put the secret key (sk_...) in the frontend.
VITE_STRIPE_PUBLISHABLE_KEY=
